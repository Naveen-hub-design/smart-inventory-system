# ------------------------------------------------------------------
# SIMS — Environment variables
# ------------------------------------------------------------------

# Backend API base URL (used by Axios). Leave as-is for the Vite proxy.
VITE_API_URL=/api

# ------------------------------------------------------------------
# Google OAuth ("Continue with Google" on the login page)
# ------------------------------------------------------------------
# 1. Create a Web application OAuth 2.0 Client ID at:
#    Google Cloud Console > APIs & Services > Credentials > Create Credentials
# 2. Add http://localhost:5173/oauth/google/callback (or your production
#    URL) to "Authorized redirect URIs".
# 3. Set the client ID here. If left empty, the "Continue with Google"
#    button stays visible but shows a "not configured" message instead of
#    faking authentication.
#
# NOTE: Never put the Google client SECRET here. Secrets belong only on the
# backend. The frontend client ID is public by design.
VITE_GOOGLE_CLIENT_ID=

# Optional. Defaults to <window.location.origin>/oauth/google/callback
VITE_GOOGLE_REDIRECT_URI=

# Backend requirement for Google sign-in to actually work:
#   POST /api/auth/google  body: { "code": "<authorization_code>" }
# The backend must verify the code with Google's token endpoint, load or
# create the SIMS user by email, and return the same shape as /auth/login:
#   { "access_token", "refresh_token", "user" }

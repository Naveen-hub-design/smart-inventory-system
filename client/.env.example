# ------------------------------------------------------------------
# SIMS — Environment variables
# ------------------------------------------------------------------

# Backend API base URL (used by Axios). Leave as-is for the Vite proxy.
VITE_API_URL=/api

# ------------------------------------------------------------------
# Google Sign-In ("Continue with Google" on the login page)
# Uses Google Identity Services: the button opens Google's account
# chooser, then the ID token is verified server-side. No redirect URI
# is required for this flow.
# ------------------------------------------------------------------
# 1. Create a Web application OAuth 2.0 Client ID at:
#    Google Cloud Console > APIs & Services > Credentials > Create Credentials
# 2. Add http://localhost:5173 (and your production origin) to
#    "Authorized JavaScript origins". No redirect URI is needed.
# 3. Set the SAME client ID here and as GOOGLE_CLIENT_ID on the backend
#    (see server/.env.example). If left empty, the "Continue with Google"
#    button stays visible but shows a "not configured" message instead of
#    faking authentication.
#
# NOTE: Never put the Google client SECRET here. Secrets belong only on the
# backend. The frontend client ID is public by design.
VITE_GOOGLE_CLIENT_ID=

# Legacy variable from the old redirect-based flow. No longer used by the
# "Continue with Google" button; kept only so older setups keep parsing.
VITE_GOOGLE_REDIRECT_URI=

# Backend requirement for Google sign-in to actually work:
#   POST /api/auth/google  body: { "credential": "<Google ID token>" }
# The backend verifies the token with Google, matches the verified email
# to an EXISTING, ACTIVE SIMS user (never creates one), and returns the
# same shape as /auth/login:
#   { "access_token", "refresh_token", "user" }

# ------------------------------------------------------------------
# SIMS backend — environment variables (copy to .env, never commit .env)
# ------------------------------------------------------------------

SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-must-be-at-least-32-bytes-long!
DATABASE_URL=sqlite:///instance/sims.db
FLASK_ENV=production

# Google Sign-In ("Continue with Google" on the login page).
# The SAME OAuth 2.0 Web-application Client ID as VITE_GOOGLE_CLIENT_ID.
# The backend uses it as the required audience when verifying the Google
# ID token server-side. If empty, POST /api/auth/google fails closed
# with a "not configured" error.
GOOGLE_CLIENT_ID=
